/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/chat-app/*
  X-Content-Type-Options: nosniff
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:; frame-src 'self' http: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/chat-app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/stella-logo.png
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/stella-logo.svg
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/stella-logo-ui.png
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/mock-app-icons/*
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/app-mocks/*
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/demos/*
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800
