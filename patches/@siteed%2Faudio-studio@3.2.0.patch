new file mode 100644
index 0000000000000000000000000000000000000000..7541f7f45df5f94ea2d27e95fb6c1be9c88df480
--- /dev/null
+++ b/ios/AudioStudioExceptionCatcher.h
@@ -0,0 +1,11 @@
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface AudioStudioExceptionCatcher : NSObject
+
++ (BOOL)catchException:(NS_NOESCAPE void (^)(void))block error:(NSError * _Nullable * _Nullable)error;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/ios/AudioStudioExceptionCatcher.m b/ios/AudioStudioExceptionCatcher.m
new file mode 100644
index 0000000000000000000000000000000000000000..3b7cc44a17072452d2e23d3764ea25a18d0a3211
--- /dev/null
+++ b/ios/AudioStudioExceptionCatcher.m
@@ -0,0 +1,20 @@
+#import "AudioStudioExceptionCatcher.h"
+
+@implementation AudioStudioExceptionCatcher
+
++ (BOOL)catchException:(NS_NOESCAPE void (^)(void))block error:(NSError * _Nullable * _Nullable)error {
+  @try {
+    block();
+    return YES;
+  } @catch (NSException *exception) {
+    if (error != NULL) {
+      NSString *reason = exception.reason ?: exception.name;
+      *error = [NSError errorWithDomain:exception.name
+                                   code:1
+                               userInfo:@{NSLocalizedDescriptionKey: reason}];
+    }
+    return NO;
+  }
+}
+
+@end
