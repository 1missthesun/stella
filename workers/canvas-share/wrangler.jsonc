{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],

  // The shared-view page (packages/desktop-rune/web/share/build.ts writes it here; `bun run build:view`).
  "assets": {
    "directory": "./view-assets",
    "binding": "ASSETS",
    // The page template is fetched by its exact name; never redirect `page.html` to `page`.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "r2_buckets": [
    {
      "binding": "SHARES_BUCKET",
      "bucket_name": "stella-canvas-shares"
    }
  ],

  "vars": {
    "SHARES_DISABLED": "",
    "OWNER_SITE_URL": "https://stella.sh"
  },

  "routes": [
    {
      "pattern": "stellashare.app",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
