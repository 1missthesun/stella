{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],

  "r2_buckets": [
    {
      "binding": "SHARES_BUCKET",
      "bucket_name": "stella-canvas-shares"
    }
  ],

  "vars": {
    "SHARES_DISABLED": "",
    "OWNER_SITE_URL": "https://stella.sh"
  },

  "routes": [
    {
      "pattern": "stellashare.app",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
