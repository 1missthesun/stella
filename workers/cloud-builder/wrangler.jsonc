{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-cloud-builder-dev",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "auth-dev.stella.sh", "custom_domain": true }],
  "main": ".wrangler/worker-build/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": ".wrangler/worker-build",
  "upload_source_maps": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js"], "fallthrough": true },
    { "type": "CompiledWasm", "fallthrough": false, "globs": ["**/*.wasm"] },
  ],
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": [
      "src",
      "scripts/build-worker.mjs",
      "../../packages/agent/src",
      "../../packages/contracts",
      "../../packages/executor-cloud/src",
      "../../packages/executor-cloud/package.json",
      "../../packages/model-catalog",
      "../../packages/runtime/package.json",
      "../../packages/runtime/kernel",
      "../../packages/runtime/extensions",
      "../../packages/runtime/host",
      "../../packages/runtime/worker",
      "../../packages/runtime/observability",
    ],
  },
  "assets": {
    "directory": ".wrangler/sandbox-code",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "compatibility_date": "2026-07-22",
  // Pending service-binding calls, RPC, waitUntil and timers keep a Durable
  // Object alive (up to 15 minutes each). A resident agent turn waits on the
  // model and browser gateways through bindings; without this it could be
  // evicted mid-call. Default from compatibility date 2026-10-01.
  "compatibility_flags": ["nodejs_compat", "durable_object_io_tasks_prevent_eviction"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "vars": {
    "STELLA_AUTH_URL": "https://auth-dev.stella.sh",
    "TELEMETRY_ENVIRONMENT": "development",
    "TURN_TIMEOUT_MS": "900000",
    "SANDBOX_IDLE_TIMEOUT_MS": "600000",
    "SANDBOX_PREWARM_IDLE_TIMEOUT_MS": "90000",
    "ORCHESTRATOR_IDLE_TIMEOUT_MS": "120000",
    "SANDBOX_SNAPSHOTS": "1",
    "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-dev.fromyou.workers.dev",
    // Dev only: `/api/admin/test-accounts/session` mints signed-in
    // `@test.stella.local` users, whose magic links are logged, not sent.
    // Production and acceptance configs must omit it.
    "STELLA_TEST_ACCOUNTS": "1",
    "STELLA_LOCAL_DEV_ORIGINS": "1",
    // Dev only until it ships: Slack workspace environments
    // (`src/slack/environment.ts`). Unset, Slack agent containers keep the
    // default network and the settings page hides the section.
    "SLACK_ENVIRONMENTS": "1",
    "STELLA_DEPLOYMENT_IDENTITY": "dev:outgoing-bulldog-865",
    "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway-dev.fromyou.workers.dev",
    "CAPABILITY_SIGNING_KID": "builder-1",
    "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-dev.fromyou.workers.dev",
    "R2_S3_ENDPOINT": "https://f34b91c9c7dc22f0aef0ba855a9f026f.r2.cloudflarestorage.com",
    "R2_DRIVE_BUCKET": "stella-v2-drive-dev",
    "R2_MEDIA_BUCKET": "stella-v2-media-dev",
    "R2_BACKUP_BUCKET": "stella-v2-app-builds-dev",
    "CANVAS_SHARE_BASE_URL": "https://stellashare.app",
    "CANVAS_OWNER_SITE_URL": "https://stella-website-dev.fromyou.workers.dev",
    "SITES_HOST": "*-dev.stellasites.app",
    "SITES_SHARED_ORIGIN": "",
    "STELLA_EMAIL_FROM": "Stella <noreply@stella.sh>",
  },
  "secrets": {
    "required": [
      "BUILDER_SERVICE_SECRET",
      "BETTER_AUTH_SECRET",
      "CAPABILITY_SIGNING_KEY",
    ],
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "stella-app-dev",
    },
  ],
  // Cloudflare Email Service: magic-link mail. The sender is STELLA_EMAIL_FROM
  // (or RESEND_FROM) and its domain must be enabled for Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "services": [
    {
      "binding": "TELEMETRY",
      "service": "stella-v2-telemetry-dev",
      "entrypoint": "TelemetryService",
    },
    {
      "binding": "BROWSER_GATEWAY",
      "service": "stella-v2-browser-gateway-dev",
    },
    {
      "binding": "MODEL_GATEWAY",
      "service": "stella-v2-model-gateway-dev",
    },
    {
      "binding": "MODEL_GATEWAY_CONTROL",
      "service": "stella-v2-model-gateway-dev",
      "entrypoint": "ModelGatewayControl",
    },
  ],
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev",
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "stella-v2-app-builds-dev",
    },
    {
      "binding": "AGENT_HOME",
      "bucket_name": "stella-v2-agent-home-dev",
    },
    {
      "binding": "CONVERSATION_ARCHIVE",
      "bucket_name": "stella-v2-conversation-archive-dev",
    },
    {
      "binding": "WORLDS_BUCKET",
      "bucket_name": "stella-v2-worlds-dev",
    },
    {
      "binding": "DRIVE",
      "bucket_name": "stella-v2-drive-dev",
    },
    {
      "binding": "MEDIA",
      "bucket_name": "stella-v2-media-dev",
    },
    {
      "binding": "CANVAS_SHARES",
      "bucket_name": "stella-canvas-shares",
    },
  ],
  "triggers": { "crons": ["17 3 * * *", "41 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stella-v2-dev",
      "database_id": "a2cd9816-891c-4642-9f07-094251947a84",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7",
    },
    {
      "binding": "ASN_POLICY",
      "id": "a255c73f45c94af094c46f604aaa50e8",
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "stella-v2-cloud-builder-dev-sandbox-do",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
      {
        "name": "BUILD_SESSIONS",
        "class_name": "BuildSession",
      },
      {
        "name": "ORCHESTRATOR_SESSIONS",
        "class_name": "OrchestratorSession",
      },
      {
        "name": "OWNER_GATES",
        "class_name": "OwnerGate",
      },
      {
        "name": "MODEL_GATEWAY_OWNERS",
        "class_name": "OwnerRelayGate",
        "script_name": "stella-v2-model-gateway-dev",
      },
      {
        "name": "WORLDS",
        "class_name": "WorldStore",
      },
      {
        "name": "APP_RELEASES",
        "class_name": "AppReleaseChannel",
      },
      {
        "name": "SLACK_PREVIEW_DATA",
        "class_name": "SlackPreviewData",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "BuildSession"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrchestratorSession"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxSmall"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["OwnerTransferCoordinator"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["AppBuildSandbox"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["DevicePresence"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["OwnerGate"],
    },
    {
      "tag": "v8",
      "deleted_classes": ["DevicePresence"],
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["WorldStore"],
    },
    {
      "tag": "v10",
      "deleted_classes": ["SandboxSmall", "AppBuildSandbox"],
    },
    {
      "tag": "v11",
      "deleted_classes": ["OwnerTransferCoordinator"],
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["AppReleaseChannel"],
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["SlackPreviewData"],
    },
  ],
  // Per-agent Worker Previews (DEPLOY.md, "Previews"). Deploy them only with
  // `bun run preview -- up`: it targets the separate Worker
  // stella-v2-cloud-builder-preview, never this dev Worker, creates the
  // Preview's own D1 database in place of PREVIEW_D1_DATABASE_ID, and passes
  // the Preview's own URL as CLOUD_BUILDER_PUBLIC_URL. Durable Objects and
  // containers are separate per Preview automatically. R2 and APP_ROUTES are
  // test resources shared by every Preview (objects expire after 14 days);
  // service bindings reach the dev Workers. Secrets come from the preview
  // Worker's base config (`bun run preview -- setup-secrets`).
  "previews": {
    "vars": {
      "TELEMETRY_ENVIRONMENT": "development",
      "TURN_TIMEOUT_MS": "900000",
      "SANDBOX_IDLE_TIMEOUT_MS": "600000",
      "SANDBOX_PREWARM_IDLE_TIMEOUT_MS": "90000",
      "ORCHESTRATOR_IDLE_TIMEOUT_MS": "120000",
      "SANDBOX_SNAPSHOTS": "1",
      "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-dev.fromyou.workers.dev",
      "STELLA_TEST_ACCOUNTS": "1",
      "STELLA_LOCAL_DEV_ORIGINS": "1",
      "STELLA_DEPLOYMENT_IDENTITY": "dev:outgoing-bulldog-865",
      "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway-dev.fromyou.workers.dev",
      "CAPABILITY_SIGNING_KID": "builder-preview-1",
      "R2_S3_ENDPOINT": "https://f34b91c9c7dc22f0aef0ba855a9f026f.r2.cloudflarestorage.com",
      "R2_DRIVE_BUCKET": "stella-v2-drive-preview",
      "R2_MEDIA_BUCKET": "stella-v2-media-preview",
      "R2_BACKUP_BUCKET": "stella-v2-app-builds-preview",
      "CANVAS_SHARE_BASE_URL": "https://stellashare.app",
      "CANVAS_OWNER_SITE_URL": "https://stella-website-dev.fromyou.workers.dev",
      "STELLA_EMAIL_FROM": "Stella <noreply@stella.sh>",
    },
    "observability": {
      "enabled": true,
      "redact_query_string": true,
      "issues": { "enabled": true },
      "logs": {
        "enabled": true,
        "invocation_logs": false,
        "persist": true,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 0.05,
        "persist": true,
      },
    },
    "artifacts": [
      {
        "binding": "ARTIFACTS",
        "namespace": "stella-app-dev",
      },
    ],
    "send_email": [{ "name": "EMAIL" }],
    "ai": { "binding": "AI" },
    "images": { "binding": "IMAGES" },
    "worker_loaders": [
      {
        "binding": "LOADER",
      },
    ],
    "services": [
      {
        "binding": "TELEMETRY",
        "service": "stella-v2-telemetry-dev",
        "entrypoint": "TelemetryService",
      },
      {
        "binding": "BROWSER_GATEWAY",
        "service": "stella-v2-browser-gateway-dev",
      },
      {
        "binding": "MODEL_GATEWAY",
        "service": "stella-v2-model-gateway-dev",
      },
      {
        "binding": "MODEL_GATEWAY_CONTROL",
        "service": "stella-v2-model-gateway-dev",
        "entrypoint": "ModelGatewayControl",
      },
    ],
    "r2_buckets": [
      {
        "binding": "APP_BUILDS",
        "bucket_name": "stella-v2-app-builds-preview",
      },
      {
        "binding": "BACKUP_BUCKET",
        "bucket_name": "stella-v2-app-builds-preview",
      },
      {
        "binding": "AGENT_HOME",
        "bucket_name": "stella-v2-agent-home-preview",
      },
      {
        "binding": "CONVERSATION_ARCHIVE",
        "bucket_name": "stella-v2-conversation-archive-preview",
      },
      {
        "binding": "WORLDS_BUCKET",
        "bucket_name": "stella-v2-worlds-preview",
      },
      {
        "binding": "DRIVE",
        "bucket_name": "stella-v2-drive-preview",
      },
      {
        "binding": "MEDIA",
        "bucket_name": "stella-v2-media-preview",
      },
      {
        "binding": "CANVAS_SHARES",
        "bucket_name": "stella-canvas-shares",
      },
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "PREVIEW_D1_DATABASE_NAME",
        "database_id": "PREVIEW_D1_DATABASE_ID",
        "migrations_dir": "migrations",
      },
    ],
    "kv_namespaces": [
      {
        "binding": "APP_ROUTES",
        "id": "fe8608f6b0b84b069c414d65b2721a3b",
      },
      {
        "binding": "ASN_POLICY",
        "id": "a255c73f45c94af094c46f604aaa50e8",
      },
    ],
    // No `containers`: Previews accept only fixed-image container apps, and
    // the Sandbox object picks its image and instance size per start
    // (scheduling_policy "durable_object"), which Wrangler refuses under
    // `previews`. Agent sandboxes therefore cannot start in a Preview.
    "durable_objects": {
      "bindings": [
        {
          "name": "Sandbox",
          "class_name": "Sandbox",
        },
        {
          "name": "BUILD_SESSIONS",
          "class_name": "BuildSession",
        },
        {
          "name": "ORCHESTRATOR_SESSIONS",
          "class_name": "OrchestratorSession",
        },
        {
          "name": "OWNER_GATES",
          "class_name": "OwnerGate",
        },
        {
          "name": "MODEL_GATEWAY_OWNERS",
          "class_name": "OwnerRelayGate",
          "script_name": "stella-v2-model-gateway-dev",
        },
        {
          "name": "WORLDS",
          "class_name": "WorldStore",
        },
        {
          "name": "APP_RELEASES",
          "class_name": "AppReleaseChannel",
        },
        {
          "name": "SLACK_PREVIEW_DATA",
          "class_name": "SlackPreviewData",
        },
      ],
    },
  },
  "env": {
    "bn118": {
      "name": "stella-v2-cloud-builder-basic-nightingale-118",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "TELEMETRY_ENVIRONMENT": "development",
        "STELLA_LOCAL_DEV_ORIGINS": "1",
        "STELLA_PLAINTEXT_STORAGE": "1",
        "TURN_TIMEOUT_MS": "900000",
        "SANDBOX_IDLE_TIMEOUT_MS": "600000",
        "SANDBOX_PREWARM_IDLE_TIMEOUT_MS": "90000",
        "ORCHESTRATOR_IDLE_TIMEOUT_MS": "120000",
        "SANDBOX_SNAPSHOTS": "1",
        "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-basic-nightingale-118.fromyou.workers.dev",
        "ENABLE_DEV_ACCEPTANCE_PROBES": "1",
        "STELLA_DEPLOYMENT_IDENTITY": "preview:basic-nightingale-118",
        "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway-dev.fromyou.workers.dev",
        "CAPABILITY_SIGNING_KID": "builder-bn118-1",
        "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-basic-nightingale-118.fromyou.workers.dev",
      },
      "secrets": {
        "required": [
          "BUILDER_SERVICE_SECRET",
          "META_MODEL_API_KEY",
          "CAPABILITY_SIGNING_KEY",
        ],
      },
      "artifacts": [
        {
          "binding": "ARTIFACTS",
          "namespace": "stella-app-acceptance",
        },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "ai": { "binding": "AI" },
      "images": { "binding": "IMAGES" },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "services": [
        {
          "binding": "TELEMETRY",
          "service": "stella-v2-telemetry-dev",
          "entrypoint": "TelemetryService",
        },
        {
          "binding": "BROWSER_GATEWAY",
          "service": "stella-v2-browser-gateway-basic-nightingale-118",
        },
        {
          "binding": "MODEL_GATEWAY",
