    "production": {
      "name": "stella-v2-cloud-builder-prod",
      "routes": [{ "pattern": "auth.stella.sh", "custom_domain": true }],
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "issues": { "enabled": true },
        "logs": {
          "enabled": true,
          "invocation_logs": false,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      "vars": {
        "STELLA_AUTH_URL": "https://auth.stella.sh",
        "TELEMETRY_ENVIRONMENT": "production",
        "TURN_TIMEOUT_MS": "900000",
        "SANDBOX_IDLE_TIMEOUT_MS": "600000",
        "SANDBOX_PREWARM_IDLE_TIMEOUT_MS": "90000",
        "ORCHESTRATOR_IDLE_TIMEOUT_MS": "120000",
        "SANDBOX_SNAPSHOTS": "1",
        "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-prod.fromyou.workers.dev",
        "STELLA_DEPLOYMENT_IDENTITY": "prod:intent-jackal-330",
        "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway.fromyou.workers.dev",
        "CAPABILITY_SIGNING_KID": "builder-prod-1",
        "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-prod.fromyou.workers.dev",
        "R2_S3_ENDPOINT": "https://f34b91c9c7dc22f0aef0ba855a9f026f.r2.cloudflarestorage.com",
        "R2_DRIVE_BUCKET": "stella-v2-drive-prod",
        "R2_MEDIA_BUCKET": "stella-v2-media-prod",
        "R2_BACKUP_BUCKET": "stella-v2-app-builds-prod",
