{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-model-gateway-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  // global_fetch_strictly_public: the JWKS lives on cloud-builder in the same
  // account, which a plain worker-to-worker fetch can't reach (error 1042).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "limits": {
    "cpu_ms": 60000,
  },
  "vars": {
    "STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-dev.fromyou.workers.dev",
    // Dev only, never production: a desktop signed in to a cloud-builder
    // Preview (`https://<name><suffix>`, DEPLOY.md "Previews") gets its
    // session capability from that Preview, signed with `builder-preview-1`.
    "PREVIEW_BACKEND_HOST_SUFFIX": "-stella-v2-cloud-builder-preview.fromyou.workers.dev",
    // Dev only, never production: a dev test account (`@test.stella.local`,
    // the `tst` sign-in claim) gets GATEWAY_TEST_ACCOUNT_MINTS_PER_HOUR
    // session exchanges, since test runs relaunch several computers on one.
    "STELLA_TEST_ACCOUNTS": "1",
    // JSON `GatewayJwks` holding the PUBLIC ES256 keys of the capability
    // issuer (cloud-builder's `CAPABILITY_SIGNING_KID`s). Ops
    // Keep the public keys in deployment config so future deploys cannot
    // accidentally restore the fail-closed empty placeholder. `builder-preview-1`
    // signs for the per-agent cloud-builder Previews (DEPLOY.md, "Previews").
    "CAPABILITY_JWKS": "{\"keys\":[{\"kid\":\"builder-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"_zTj5c7FMbjcMng9baQbQRXtkHak6jk4-1boqSnt59A\",\"y\":\"tR-kttYxzHOPR__VorAqBes7AkaI9uvAiyuM7h7DMEk\",\"alg\":\"ES256\",\"use\":\"sig\"}},{\"kid\":\"builder-bn118-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"3B2uhLMZ0nFNovFPfyHOqiVeXac4vJO0YhR1F7U1xQc\",\"y\":\"_vW3crzH0DnvV5yjUqvxa9qH5_lygAfXR7FWiI7MLAA\",\"alg\":\"ES256\",\"use\":\"sig\"}},{\"kid\":\"builder-preview-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"fNbXqGJFsWaRGpdQmkq-4KmWvbqUVpWzbiPzbVoWyAk\",\"y\":\"gITvf5FUWXr6wCD8-rKlCTsE_FnZt-DXkC-cr5wZeTI\",\"alg\":\"ES256\",\"use\":\"sig\"}}]}",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPABILITY_LEDGER",
        "class_name": "CapabilityLedger",
      },
      {
        "name": "OWNER_RELAY_GATE",
        "class_name": "OwnerRelayGate",
      },
      {
        "name": "NETWORK_GATE",
        "class_name": "NetworkGate",
      },
      {
        "name": "TIER_BUDGET",
        "class_name": "TierBudget",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CapabilityLedger"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OwnerRelayGate", "NetworkGate", "TierBudget"],
    },
    { "tag": "v3", "new_sqlite_classes": ["OwnerCapabilityLedger"] },
    { "tag": "v4", "deleted_classes": ["OwnerCapabilityLedger"] },
  ],
  "services": [
    {
      "binding": "BILLING",
      "service": "stella-v2-cloud-builder-dev",
      "entrypoint": "BillingControl",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_SNAPSHOT",
      "id": "1cca6b348e5a4998baab44e3333a1f49",
    },
    {
      // Create one namespace per environment, then replace this id. Keys are
      // decimal ASN numbers and values are NetworkClass strings.
      "binding": "ASN_POLICY",
      "id": "a255c73f45c94af094c46f604aaa50e8",
    },
  ],
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "USAGE_QUEUE",
        "queue": "stella-v2-gateway-usage-dev",
      },
    ],
    "consumers": [
      {
        "queue": "stella-v2-gateway-usage-dev",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "stella-v2-gateway-usage-dlq-dev",
      },
    ],
  },
  "env": {
    "production": {
      "name": "stella-v2-model-gateway",
      "workers_dev": true,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 60000,
      },
      "vars": {
        "STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-prod.fromyou.workers.dev",
        "CAPABILITY_JWKS": "{\"keys\":[{\"kid\":\"builder-prod-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"7OPXbcbubpfZqHAZEptNA8Bu1w9Y5D0pq547cg8rYuo\",\"y\":\"tv8_giBW3W4shXI5YPuZMneKHs22dSncE41399_mEmI\",\"alg\":\"ES256\",\"use\":\"sig\"}}]}",
      },
      "secrets": {
        "required": ["OPENROUTER_API_KEY"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CAPABILITY_LEDGER",
            "class_name": "CapabilityLedger",
          },
          {
            "name": "OWNER_RELAY_GATE",
            "class_name": "OwnerRelayGate",
          },
          {
            "name": "NETWORK_GATE",
            "class_name": "NetworkGate",
          },
          {
            "name": "TIER_BUDGET",
            "class_name": "TierBudget",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["CapabilityLedger"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OwnerRelayGate", "NetworkGate", "TierBudget"],
        },
        { "tag": "v3", "new_sqlite_classes": ["OwnerCapabilityLedger"] },
        { "tag": "v4", "deleted_classes": ["OwnerCapabilityLedger"] },
      ],
      "services": [
        {
          "binding": "BILLING",
          "service": "stella-v2-cloud-builder-prod",
          "entrypoint": "BillingControl",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_SNAPSHOT",
          "id": "4a6ff4e237de4cf59d85334c1053645b",
        },
        {
          "binding": "ASN_POLICY",
          "id": "ead91aec5ef6410d92a530974f220797",
        },
      ],
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
      "queues": {
        "producers": [
          {
            "binding": "USAGE_QUEUE",
            "queue": "stella-v2-gateway-usage",
          },
        ],
        "consumers": [
          {
            "queue": "stella-v2-gateway-usage",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "stella-v2-gateway-usage-dlq",
          },
        ],
      },
    },
  },
}
