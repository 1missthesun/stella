{
  "name": "@stella/preview-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:dev": "wrangler deploy --config wrangler.jsonc --env=\"\" --strict",
    "deploy:production": "wrangler deploy --config wrangler.jsonc --env production --strict",
    "typecheck": "tsc --noEmit && bun run types:check",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-interface PreviewHostBindings",
    "types:check": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-interface PreviewHostBindings --check",
    "build:dry-run": "wrangler deploy --dry-run --env=\"\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "npm:typescript@^7.0.2",
    "wrangler": "4.147.0"
  }
}
