{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Cloudflare's free Universal SSL covers the stellasites.app apex and one wildcard level only.
  "name": "stella-v2-sites-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "*-dev.stellasites.app/*", "zone_name": "stellasites.app" }],
  "vars": { "SITES_APEX": "" },
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": false },
  },
  "services": [
    {
      "binding": "SITES",
      "service": "stella-v2-cloud-builder-dev",
      "entrypoint": "SitesHost",
    },
  ],
  "env": {
    "production": {
      "name": "stella-v2-sites-prod",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "*.stellasites.app/*", "zone_name": "stellasites.app" },
        { "pattern": "stellasites.app/*", "zone_name": "stellasites.app" },
      ],
      "vars": { "SITES_APEX": "stellasites.app" },
      "observability": {
        "redact_query_string": true,
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
        "traces": { "enabled": false },
      },
      "services": [
        {
          "binding": "SITES",
          "service": "stella-v2-cloud-builder-prod",
          "entrypoint": "SitesHost",
        },
      ],
    },
  },
}
