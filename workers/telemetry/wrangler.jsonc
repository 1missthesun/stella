{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-telemetry-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  // A plain fetch to another worker in the same account fails (error 1042) without this flag.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-dev.fromyou.workers.dev",
    "ENABLE_SERVER_BEARER": "1"
  },
  "secrets": {
    "required": [
      "TELEMETRY_PSEUDONYM_KEY",
      "TELEMETRY_SERVER_SECRET"
    ]
  },
  "pipelines": [
    {
      "binding": "EVENTS_PIPELINE",
      "stream": "07d5b9ff2b084f7b8ea00a4e3bbc1767"
    }
  ],
  "ratelimits": [
    {
      "name": "TELEMETRY_RATE_LIMITER",
      // Rate-limit namespaces are shared by every worker in the Cloudflare account.
      "namespace_id": "41001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "COUNTS_INSTALL_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "COUNTS_IP_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "COUNTS", "dataset": "stella_anonymous_counts_dev" }
  ],
  "env": {
    "production": {
      "name": "stella-v2-telemetry",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-prod.fromyou.workers.dev",
        "ENABLE_SERVER_BEARER": "1"
      },
      "secrets": {
        "required": [
          "TELEMETRY_PSEUDONYM_KEY",
          "TELEMETRY_SERVER_SECRET"
        ]
      },
      "pipelines": [
        {
          "binding": "EVENTS_PIPELINE",
          "stream": "432c62bb00c7417cbc62ad5af1ecb9e8"
        }
      ],
      "ratelimits": [
        {
          "name": "TELEMETRY_RATE_LIMITER",
          "namespace_id": "41002",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "COUNTS_INSTALL_RATE_LIMITER",
          "namespace_id": "41005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "COUNTS_IP_RATE_LIMITER",
          "namespace_id": "41006",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "analytics_engine_datasets": [
        { "binding": "COUNTS", "dataset": "stella_anonymous_counts" }
      ]
    }
  }
}
